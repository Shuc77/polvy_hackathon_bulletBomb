{
  "name": "polyv-web-live-watch-sdk",
  "version": "2.15.0",
  "private": true,
  "scripts": {
    "dev:cli": "vue-cli-service serve",
    "dev:webpack": "webpack serve --config webpack.config.js",
    "build:cli": "cross-env NODE_ENV=production vue-cli-service build --no-module",
    "build:webpack": "cross-env USE_PARALLEL_LINT=true NODE_ENV=production webpack-cli build --config webpack.config.js",
    "dev": "npm run dev:webpack",
    "build": "npm run build:webpack",
    "dev-sdk-inject": "cross-env VUE_APP_BUILD_MODE=SDK_INJECT npm run dev:webpack",
    "dev-feed-inject": "cross-env VUE_APP_MAIN_MODE=Feed npm run dev-sdk-inject",
    "build-static": "cross-env VUE_APP_BUILD_MODE=STATIC npm run build",
    "build-sdk-inject": "cross-env VUE_APP_BUILD_MODE=SDK_INJECT npm run build",
    "build-feed-inject": "cross-env VUE_APP_MAIN_MODE=Feed npm run build-sdk-inject",
    "generate-icon": "polyv-icon generate",
    "check": "vue-tsc --noEmit --skipLibCheck",
    "check:prod": "npm run check -- --project ./tsconfig.build.json",
    "lint-es": "cross-env NODE_ENV=production eslint . --ext .js,.ts,.vue",
    "lint-style": "stylelint **/*.{css,scss,sass,vue}",
    "lint": "npm run lint-es && npm run lint-style",
    "lint-fix-es": "eslint . --ext .js,.ts,.vue --fix",
    "lint-fix-style": "stylelint **/*.{css,scss,sass,vue} --fix",
    "lint-fix": "npm run lint-fix-es && npm run lint-fix-style",
    "precommit": "lint-staged",
    "prepare": "husky install .husky"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "cross-env NODE_ENV=production eslint"
    ],
    "*.{css,sass,scss,vue}": [
      "stylelint"
    ]
  },
