# Browser-safe Polyv account App ID.
VITE_POLYV_APP_ID=hmpc5skuwx

# Optional. Leave empty to run the standalone demonstration watch page.
VITE_POLYV_CHANNEL_ID=8574764

# Optional. Used for a specific live session when the channel supports sessions.
VITE_POLYV_TARGET_SESSION_ID=

# Backend only. Never expose these in a VITE_* variable.
SERVER_PORT=8787
# 仅本机访问用 127.0.0.1；手机/其他电脑经局域网访问时改为 0.0.0.0
SERVER_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:15021,http://127.0.0.1:15021
POLYV_APP_ID=hmpc5skuwx
POLYV_APP_SECRET=

# OpenAI-compatible chat completions API. DeepSeek is configured for this demo.
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=25000

# Keep true for a visibly labeled rules-based fallback when no API key is set.
ALLOW_DEMO_AI=true

# Browser-safe API endpoint used by the widget bundle.
VITE_AI_API_URL=/api/chat
